# Server-only variables. Never expose these to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# Newer Supabase projects may use a secret key instead:
# SUPABASE_SECRET_KEY=replace-with-server-only-secret
API_SECRET=replace-with-a-long-random-secret
